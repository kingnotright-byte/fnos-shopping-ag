# ===== 服务鉴权（必须修改，勿用默认值）=====
PROXY_TOKEN=please-change-me

# ===== 拼多多方舟（open.pinduoduo.com）=====
# 应用 client_id / client_secret / PID（多多进宝后台绑定推广位后获取）
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# ===== 什么值得买（openapi.zhidemai.com）=====
# 海纳 API Key（邮件申请，测试通过后获正式 Key）
SMZDM_API_KEY=

# ===== 服务端口 =====
PORT=8787
